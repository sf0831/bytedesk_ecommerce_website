    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "vite": "^7.1.0"
  }
}
